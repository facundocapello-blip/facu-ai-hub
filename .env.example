# Firebase Web app config is public; Firestore rules protect user data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional same-origin or HTTPS endpoint for server-side intent classification.
VITE_AI_ENDPOINT=
# For GitHub Pages builds: /facu-ai-hub/
VITE_BASE_PATH=/
# Optional: force a fully local workspace without Firebase.
VITE_LOCAL_ONLY=false
